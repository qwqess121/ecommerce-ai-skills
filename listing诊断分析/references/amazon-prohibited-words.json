{
  "_meta": {
    "version": "1.0.0",
    "last_updated": "2026-09-24",
    "source": "Amazon Seller Central Style Guides, Restricted Products Policy, Claims Guidelines",
    "notes": "定期根据亚马逊最新政策更新。严重程度：high=可能导致listing下架/账号风险, medium=影响搜索/转化, low=格式不规范"
  },
  "promotional_language": {
    "severity": "high",
    "description": "促销类语言——亚马逊明确禁止在标题和描述中使用",
    "words": [
      "best seller", "bestseller", "#1", "number one", "top rated", "top selling",
      "best quality", "best price", "best value", "best deal",
      "free shipping", "free delivery", "free gift", "free bonus",
      "discount", "discounted", "on sale", "sale price", "clearance",
      "save money", "save $", "cheapest", "lowest price",
      "deal of the day", "limited time offer", "limited time deal",
      "act now", "buy now", "order now", "hurry",
      "while supplies last", "don't miss out", "last chance",
      "exclusive offer", "special offer", "special price", "special deal",
      "promotion", "promo", "promotional",
      "coupon", "voucher", "rebate",
      "hot sale", "flash sale", "big sale",
      "wholesale", "wholesale price",
      "bargain", "steal", "giveaway"
    ],
    "replacement_suggestions": {
      "best seller": "popular choice",
      "top rated": "highly reviewed",
      "#1": "(删除)",
      "free shipping": "(删除——亚马逊自动处理配送信息)",
      "discount": "(删除——促销信息放Coupon/Deal设置)",
      "limited time offer": "(删除)",
      "buy now": "(删除)"
    }
  },
