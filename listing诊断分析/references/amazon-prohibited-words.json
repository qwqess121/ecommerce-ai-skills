  "environmental_claims": {
    "severity": "high",
    "description": "环保声明——未认证时使用违规",
    "words": [
      "eco-friendly", "eco friendly", "environmentally friendly",
      "organic", "100% organic", "certified organic",
      "biodegradable", "compostable",
      "sustainable", "sustainably sourced",
      "recyclable", "recycled",
      "green", "green product",
      "non-toxic", "non toxic", "toxin-free", "toxin free",
      "chemical-free", "chemical free",
      "carbon neutral", "carbon-free", "zero carbon",
      "zero waste", "plastic-free",
      "vegan", "cruelty-free", "cruelty free",
      "fair trade", "fairtrade",
      "natural", "100% natural", "all natural", "all-natural",
      "pesticide-free", "pesticide free",
      "BPA-free", "BPA free",
      "phthalate-free", "phthalate free",
      "paraben-free", "paraben free"
