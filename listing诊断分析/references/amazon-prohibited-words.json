  "format_violations": {
    "severity": "low",
    "description": "格式违规——不会导致下架但影响listing质量",
    "patterns": [
      "ALL CAPS WORDS (超过品牌名的全大写)",
      "HTML tags (<br>, <b>, <i>, etc.)",
      "Special Unicode characters (★, ✅, ❤, etc. in title)",
      "Repeated keywords (same word >2 times)",
      "Excessive punctuation (!!!, ???, ...)",
      "Phone numbers or URLs",
      "Email addresses",
      "Social media handles (@, #hashtag in title)"
    ]
  },
  "time_sensitive": {
    "severity": "medium",
    "description": "时间敏感词——过期后变成错误信息",
    "words": [
      "new", "newest", "latest", "brand new",
      "2024", "2023", "2022",
      "new arrival", "just arrived", "just launched",
      "new model", "new version", "new edition",
      "new design", "new release", "newly released",
      "updated", "upgraded", "improved"
    ],
    "notes": "年份过期时必须更新。'new'/'latest'等词在超过合理期限后需删除。updated/upgraded/improved 如描述具体改进可保留。"
  },
  "competitor_brand_terms": {
    "severity": "high",
    "description": "竞品品牌名——在标题/描述/后端关键词中使用构成商标侵权",
    "notes": "不列举具体品牌名。检查逻辑：提取listing中所有大写词/专有名词，与该ASIN的品牌名对比，不匹配的可能是竞品品牌名，标记人工确认。",
    "detection_rules": [
      "标题中出现非自身品牌的大写专有名词",
      "描述中出现 'compatible with [Brand]' 以外用途的品牌提及",
      "后端搜索词中包含竞品品牌名",
      "'for [Brand]' 用法需确认是否为兼容性声明"
    ]
  },
